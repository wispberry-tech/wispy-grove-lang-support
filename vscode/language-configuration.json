{
  "comments": {
    "blockComment": ["{#", "#}"]
  },
  "brackets": [
    ["<!--", "-->"],
    ["{%", "%}"],
    ["{#", "#}"],
    ["<", ">"],
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "{%", "close": " %}" },
    { "open": "{#", "close": " #}" },
    { "open": "<!--", "close": "-->", "notIn": ["comment", "string"] },
    { "open": "<", "close": ">", "notIn": ["string"] },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" }
  ],
  "surroundingPairs": [
    ["{%", "%}"],
    ["{#", "#}"],
    ["<", ">"],
    ["\"", "\""],
    ["'", "'"],
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\$\\^\\&\\*\\(\\)\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
  "onEnterRules": [
    {
      "beforeText": "<(?!(?:area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr))([_:\\w][_:\\w\\-.\\d]*)(?:(?:[^'\"/>]|\"[^\"]*\"|'[^']*')*?(?!\\/)>)[^<]*$",
      "afterText": "^</([_:\\w][_:\\w\\-.\\d]*)\\s*>",
      "action": { "indent": "indentOutdent" }
    },
    {
      "beforeText": "<(?!(?:area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr))([_:\\w][_:\\w\\-.\\d]*)(?:(?:[^'\"/>]|\"[^\"]*\"|'[^']*')*?(?!\\/)>)[^<]*$",
      "action": { "indent": "indent" }
    }
  ]
}
