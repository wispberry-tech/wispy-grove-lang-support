{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Wispy Grove Template",
  "scopeName": "text.html.grov",
  "patterns": [
    { "include": "#grov-comment" },
    { "include": "#grov-verbatim-block" },
    { "include": "#grov-tag" },
    { "include": "#grov-component-definition-open" },
    { "include": "#grov-component-definition-close" },
    { "include": "#grov-component-invocation-open" },
    { "include": "#grov-component-invocation-close" },
    { "include": "text.html.basic" }
  ],
  "repository": {
    "grov-comment": {
      "name": "comment.block.grov",
      "begin": "\\{#-?",
      "end": "-?#\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.begin.grov" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.comment.end.grov" }
      }
    },

    "grov-verbatim-block": {
      "begin": "(\\{%-?)\\s*(#)(verbatim)\\s*(-?%\\})",
      "end": "(\\{%-?)\\s*(/)(verbatim)\\s*(-?%\\})",
      "beginCaptures": {
        "1": { "name": "punctuation.section.embedded.begin.grov" },
        "2": { "name": "keyword.operator.sigil.open.grov" },
        "3": { "name": "keyword.control.verbatim.grov" },
        "4": { "name": "punctuation.section.embedded.end.grov" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.section.embedded.begin.grov" },
        "2": { "name": "keyword.operator.sigil.close.grov" },
        "3": { "name": "keyword.control.verbatim.grov" },
        "4": { "name": "punctuation.section.embedded.end.grov" }
      },
      "contentName": "string.unquoted.raw.grov"
    },

    "grov-tag": {
      "begin": "(\\{%-?)",
      "end": "(-?%\\})",
      "beginCaptures": {
        "1": { "name": "punctuation.section.embedded.begin.grov" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.section.embedded.end.grov" }
      },
      "patterns": [
        { "include": "#grov-whitespace-strip" },
        { "include": "#grov-tag-sigil" },
        { "include": "#grov-tag-keywords" },
        { "include": "#grov-expression" }
      ]
    },

    "grov-whitespace-strip": {
      "match": "(?<=\\{%)-(?=\\s)|(?<=\\s)-(?=%\\})",
      "name": "keyword.operator.whitespace.grov"
    },

    "grov-tag-sigil": {
      "patterns": [
        {
          "match": "(#)(?=[a-zA-Z])",
          "captures": {
            "1": { "name": "keyword.operator.sigil.open.grov" }
          }
        },
        {
          "match": "(:)(?=[a-zA-Z])",
          "captures": {
            "1": { "name": "keyword.operator.sigil.branch.grov" }
          }
        },
        {
          "match": "(/)(?=[a-zA-Z])",
          "captures": {
            "1": { "name": "keyword.operator.sigil.close.grov" }
          }
        }
      ]
    },

    "grov-tag-keywords": {
      "patterns": [
        {
          "match": "\\b(if|else)\\b(\\s+(if))?",
          "captures": {
            "1": { "name": "keyword.control.conditional.grov" },
            "3": { "name": "keyword.control.conditional.grov" }
          }
        },
        {
          "match": "\\b(each|as|in|empty)\\b",
          "name": "keyword.control.loop.grov"
        },
        {
          "match": "\\b(set|let)\\b",
          "name": "keyword.control.assignment.grov"
        },
        {
          "match": "\\b(import|from)\\b",
          "name": "keyword.control.import.grov"
        },
        {
          "match": "\\b(slot|fill)\\b",
          "name": "keyword.control.slot.grov"
        },
        {
          "match": "\\b(capture)\\b",
          "name": "keyword.control.capture.grov"
        },
        {
          "match": "\\b(asset|meta|hoist)\\b",
          "name": "keyword.control.web.grov"
        },
        {
          "match": "\\b(verbatim)\\b",
          "name": "keyword.control.verbatim.grov"
        }
      ]
    },

    "grov-expression": {
      "patterns": [
        { "include": "#grov-object-literal" },
        { "include": "#grov-string-double" },
        { "include": "#grov-string-single" },
        { "include": "#grov-number" },
        { "include": "#grov-boolean" },
        { "include": "#grov-null" },
        { "include": "#grov-logical-operator" },
        { "include": "#grov-filter" },
        { "include": "#grov-builtin-function" },
        { "include": "#grov-comparison-operator" },
        { "include": "#grov-ternary-operator" },
        { "include": "#grov-concatenation-operator" },
        { "include": "#grov-arithmetic-operator" },
        { "include": "#grov-assignment-operator" },
        { "include": "#grov-bracket-access" },
        { "include": "#grov-accessor" },
        { "include": "#grov-variable" }
      ]
    },

    "grov-string-double": {
      "name": "string.quoted.double.grov",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.grov"
        }
      ]
    },

    "grov-string-single": {
      "name": "string.quoted.single.grov",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.grov"
        }
      ]
    },

    "grov-number": {
      "match": "\\b\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.grov"
    },

    "grov-boolean": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.grov"
    },

    "grov-null": {
      "match": "\\b(nil|null)\\b",
      "name": "constant.language.null.grov"
    },

    "grov-logical-operator": {
      "patterns": [
        {
          "match": "\\b(and|or|not)\\b",
          "name": "keyword.operator.logical.grov"
        },
        {
          "match": "&&|\\|\\||!(?!=)",
          "name": "keyword.operator.logical.grov"
        }
      ]
    },

    "grov-object-literal": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.object.begin.grov" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.object.end.grov" }
      },
      "patterns": [
        { "include": "#grov-expression" }
      ]
    },

    "grov-filter": {
      "match": "\\|\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "0": {
          "patterns": [
            {
              "match": "\\|",
              "name": "keyword.operator.filter.grov"
            },
            {
              "match": "\\b(upper|lower|title|capitalize|trim|lstrip|rstrip|replace|truncate|center|ljust|rjust|split|wordcount|length|first|last|join|sort|reverse|unique|min|max|sum|map|batch|flatten|keys|values|abs|round|ceil|floor|int|float|default|string|bool|escape|striptags|nl2br|safe)\\b",
              "name": "support.function.filter.grov"
            },
            {
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
              "name": "support.function.filter.grov"
            }
          ]
        }
      }
    },

    "grov-builtin-function": {
      "match": "\\b(range)\\s*(?=\\()",
      "captures": {
        "1": { "name": "support.function.builtin.grov" }
      }
    },

    "grov-comparison-operator": {
      "match": "==|!=|<=|>=|<|>",
      "name": "keyword.operator.comparison.grov"
    },

    "grov-ternary-operator": {
      "match": "[?:]",
      "name": "keyword.operator.ternary.grov"
    },

    "grov-concatenation-operator": {
      "match": "~",
      "name": "keyword.operator.concatenation.grov"
    },

    "grov-arithmetic-operator": {
      "match": "[+\\-*/%]",
      "name": "keyword.operator.arithmetic.grov"
    },

    "grov-assignment-operator": {
      "match": "(?<![=!<>])=(?!=)",
      "name": "keyword.operator.assignment.grov"
    },

    "grov-bracket-access": {
      "match": "[\\[\\]]",
      "name": "punctuation.bracket.square.grov"
    },

    "grov-accessor": {
      "match": "\\.",
      "name": "punctuation.accessor.grov"
    },

    "grov-variable": {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "variable.other.grov"
    },

    "grov-component-definition-open": {
      "begin": "(<)(Component)(?=[\\s>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.grov" },
        "2": { "name": "support.class.component.definition.grov entity.name.type.component.definition.grov entity.name.tag.definition.grov" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.end.grov" }
      },
      "patterns": [
        { "include": "#grov-component-name-attribute" },
        { "include": "#grov-component-attribute" }
      ]
    },

    "grov-component-definition-close": {
      "match": "(</)(Component)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.grov" },
        "2": { "name": "support.class.component.definition.grov entity.name.type.component.definition.grov entity.name.tag.definition.grov" },
        "3": { "name": "punctuation.definition.tag.end.grov" }
      }
    },

    "grov-component-invocation-open": {
      "begin": "(<)(?!Component\\b)([A-Z][a-zA-Z0-9]*)(?=[\\s>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.grov" },
        "2": { "name": "support.class.component.grov entity.name.type.component.grov" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.end.grov" }
      },
      "patterns": [
        { "include": "#grov-component-attribute" }
      ]
    },

    "grov-component-invocation-close": {
      "match": "(</)([A-Z][a-zA-Z0-9]*)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.grov" },
        "2": { "name": "support.class.component.grov entity.name.type.component.grov" },
        "3": { "name": "punctuation.definition.tag.end.grov" }
      }
    },

    "grov-component-name-attribute": {
      "match": "(name)(=)",
      "captures": {
        "1": { "name": "entity.other.attribute-name.component.grov" },
        "2": { "name": "keyword.operator.assignment.grov" }
      }
    },

    "grov-component-attribute": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)(=)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.grov" },
            "2": { "name": "keyword.operator.assignment.grov" }
          }
        },
        { "include": "#grov-attribute-expression" },
        { "include": "#grov-string-double" },
        { "include": "#grov-string-single" }
      ]
    },

    "grov-attribute-expression": {
      "begin": "(\\{)(?![%#])",
      "end": "(\\})",
      "beginCaptures": {
        "1": { "name": "punctuation.section.embedded.begin.attribute.grov" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.section.embedded.end.attribute.grov" }
      },
      "patterns": [
        { "include": "#grov-expression" }
      ]
    }
  }
}
